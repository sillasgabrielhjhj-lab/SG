# Copie para ".env.local" (no seu computador) ou cadastre na Vercel (Settings > Environment Variables).
# Também é possível preencher direto nos arquivos indicados. A variável, quando existe, tem prioridade.

# PIX OFICIAL DA CAMPANHA (src/config/pix.ts)
# Chave Pix: e-mail, CPF, CNPJ, chave aleatória ou telefone no formato +55DDDNÚMERO.
# Vazia = a página /doar mostra "doações por Pix em breve" e não gera QR Code.
PIX_KEY=
# Nome e cidade do titular da chave, como no banco (recomendados; o nome aparece para conferência).
PIX_RECEIVER_NAME=
PIX_RECEIVER_CITY=

# META (src/config/fundraising.ts). Em reais, sem ponto de milhar: 15000 ou 15000,50.
# Vazias = o site mostra só o objetivo da campanha, sem números.
FUNDRAISING_GOAL=
FUNDRAISING_RAISED=
# Data da última conferência (AAAA-MM-DD)
FUNDRAISING_UPDATED_AT=

# CONTATO OFICIAL (src/content/transparency.ts). O que ficar vazio não é exibido.
CONTACT_EMAIL=
# Só números, com DDI e DDD. Ex.: 5511999999999
CONTACT_WHATSAPP=
CONTACT_INSTAGRAM=

# Endereço público do site (Open Graph, sitemap e compartilhamento). Na Vercel é detectado sozinho;
# defina só se usar domínio próprio. Ex.: https://ajudemay.com.br
NEXT_PUBLIC_SITE_URL=
