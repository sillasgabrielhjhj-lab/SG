# Copie para .env e preencha. Nunca suba o .env para o GitHub.

# Nome do produto (aparece em todas as telas)
APP_NAME=PedeZap

# Endereço público do site, sem barra no final (usado nos links e no QR Code)
BASE_URL=https://seudominio.com.br

PORT=3000
DATA_DIR=./data

# Mensalidade em centavos (4990 = R$ 49,90) e dias de teste grátis
PRICE_CENTS=4990
TRIAL_DAYS=7

# Meta de MRR mostrada no admin, em centavos (10000000 = R$ 100.000,00)
GOAL_CENTS=10000000

# E-mails com acesso ao /admin (separados por vírgula). Crie a conta normalmente em /cadastro.
ADMIN_EMAILS=seuemail@gmail.com

# Seu WhatsApp de suporte/vendas (DDI + DDD + número). Recebe os pedidos da loja demo.
SUPPORT_WHATSAPP=5581999999999

# Sua chave PIX para receber as mensalidades (já no formato do banco:
# telefone +5581999999999, CPF só números, e-mail ou chave aleatória)
BILLING_PIX_KEY=+5581999999999
BILLING_PIX_NAME=Seu Nome Completo
BILLING_PIX_CITY=Recife

# Deixe 1 se o app roda atrás de proxy (Railway, Render, Nginx, Caddy). 0 se exposto direto.
TRUST_PROXY=1

# Cria a loja /loja/demo para a landing page
SEED_DEMO=1
