# Copie este arquivo para ".env.local" (no seu computador) ou cadastre estas variáveis na Vercel
# (Project Settings > Environment Variables). Também é possível preencher direto em src/config/campaign.ts.

# OPCIONAIS. O site funciona só com a chave Pix. Se preencher, o nome do recebedor passa a ser exibido
# e nome/cidade entram no código Pix (sem acento; até 25 e 15 letras). Vazio = valores neutros.
NEXT_PUBLIC_PIX_RECEIVER_NAME=
NEXT_PUBLIC_PIX_RECEIVER_CITY=

# Endereço público do site (Open Graph, sitemap e links de compartilhamento).
# Na Vercel é detectado sozinho; defina só se usar domínio próprio. Ex.: https://todospelotobias.com.br
NEXT_PUBLIC_SITE_URL=

# Contato da organização (opcionais; o que ficar vazio não é exibido).
# WhatsApp: somente números, com DDI e DDD. Ex.: 5511999999999
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_INSTAGRAM=
