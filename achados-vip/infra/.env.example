# =============================================================================
# Achados VIP — variáveis de PRODUÇÃO (docker compose)
# =============================================================================
# Como usar (a partir da pasta infra/):
#   cp .env.example .env
#   ./scripts/generate-secrets.sh --write     # preenche os segredos vazios abaixo
#   nano .env                                 # ajuste DOMAIN e ACME_EMAIL
#   chmod 600 .env                            # só o seu usuário lê
#
# REGRAS:
#  - O arquivo .env NUNCA vai para o git (já está no .gitignore) e NUNCA deve ser enviado por chat/e-mail.
#  - Guarde uma cópia do .env em um gerenciador de senhas, FORA do servidor. Sem APP_ENCRYPTION_KEY
#    as credenciais salvas no painel ficam irrecuperáveis; sem BACKUP_PASSPHRASE os backups cifrados também.
#  - Valores sem aspas e sem espaços ao redor do "=".
#  - Gerar um segredo manualmente:   openssl rand -base64 32     (ou -hex 32 para senhas de banco/Redis)
# =============================================================================


# ----------------------------------------------------------------------------
# Domínio e HTTPS (Caddy emite e renova o certificado Let's Encrypt sozinho)
# ----------------------------------------------------------------------------
# Domínio público do painel. O DNS (registro A, e AAAA se usar IPv6) já precisa apontar para o IP do servidor
# e as portas 80 e 443 precisam estar liberadas. Para testar localmente use: localhost (certificado interno, não confiável).
DOMAIN=painel.seudominio.com.br

# E-mail para avisos de expiração/emissão de certificado (Let's Encrypt).
ACME_EMAIL=voce@seudominio.com.br


# ----------------------------------------------------------------------------
# PostgreSQL 16 (rede interna: sem porta publicada)
# ----------------------------------------------------------------------------
POSTGRES_USER=achados
POSTGRES_DB=achados

# Senha do banco. Use SOMENTE letras e números (ela entra numa URL de conexão):
#   openssl rand -hex 32
# O generate-secrets.sh já gera neste formato.
POSTGRES_PASSWORD=


# ----------------------------------------------------------------------------
# Redis 7 (rede interna; usado pelas filas BullMQ)
# ----------------------------------------------------------------------------
# Também só letras e números:   openssl rand -hex 32
REDIS_PASSWORD=


# ----------------------------------------------------------------------------
# Segredos da aplicação
# ----------------------------------------------------------------------------
# Chave AES-256-GCM que criptografa as credenciais salvas no painel (tokens do Telegram, WhatsApp, Mercado Livre...).
# Deve ser base64 de EXATAMENTE 32 bytes (44 caracteres terminando em "="):   openssl rand -base64 32
# ATENÇÃO: se você trocar esta chave, as credenciais já salvas não poderão mais ser lidas (precisarão ser
# cadastradas de novo no painel). Veja "Rotação de segredos" em docs/DEPLOY.md.
APP_ENCRYPTION_KEY=

# Assina o cookie de sessão. Mínimo de 32 caracteres, aleatório:   openssl rand -base64 48
# Trocar esta chave encerra todas as sessões abertas (todo mundo precisa entrar de novo) — é seguro fazer.
SESSION_SECRET=


# ----------------------------------------------------------------------------
# Mercado Livre — OPCIONAL aqui (detalhes em docs/INTEGRACOES.md)
# ----------------------------------------------------------------------------
# Credenciais do app criado no DevCenter do Mercado Livre. Se o painel (Integrações > Mercado Livre) oferecer o
# cadastro, prefira o painel: lá o valor fica criptografado no banco. Estas variáveis servem de alternativa.
# O refresh token é obtido com:  ./scripts/ml-oauth.sh
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=


# ----------------------------------------------------------------------------
# Operação
# ----------------------------------------------------------------------------
# Nível de log da API/worker: fatal | error | warn | info | debug | trace | silent  (padrão: info)
LOG_LEVEL=info

# Tag das imagens Docker construídas localmente (deixe "latest"; o deploy.sh guarda a anterior como "previous").
APP_VERSION=latest

# Fuso usado apenas pelo agendamento do backup (BACKUP_TIME). A aplicação guarda tudo em UTC;
# o horário de silêncio das publicações usa o fuso configurado no painel.
TZ=America/Sao_Paulo


# ----------------------------------------------------------------------------
# Backup diário do PostgreSQL (serviço "backup")
# ----------------------------------------------------------------------------
# Horário do backup diário (HH:MM, no fuso TZ acima).
BACKUP_TIME=03:30

# Quantos dias de backups manter (mínimo 1). Backups mais antigos são apagados após um backup bem-sucedido.
BACKUP_RETENTION_DAYS=14

# Criptografia por senha (openssl AES-256-CBC + PBKDF2). Vazio = backup SEM criptografia (o script avisa nos logs).
# Gere com:   openssl rand -base64 33     (o generate-secrets.sh já gera)
# GUARDE ESTA SENHA FORA DO SERVIDOR: sem ela o backup cifrado não abre.
BACKUP_PASSPHRASE=

# ALTERNATIVA mais forte (opcional): criptografia com chave pública "age". Se definida, tem prioridade sobre
# BACKUP_PASSPHRASE. Gere o par de chaves no SEU computador (age-keygen -o chave.txt), cole aqui só a chave
# pública (começa com "age1...") e guarde chave.txt fora do servidor. O servidor passa a poder cifrar, mas não decifrar.
BACKUP_AGE_RECIPIENT=

# Onde guardar os backups. Vazio = volume Docker "backups". Para uma pasta do servidor use um caminho absoluto
# (ex.: /var/backups/achados) e antes rode:  sudo mkdir -p /var/backups/achados && sudo chown 70:70 /var/backups/achados
BACKUP_PATH=

# Monitoramento do backup (opcional): URL de "dead man's switch" (ex.: healthchecks.io). O serviço faz GET na URL
# a cada backup bem-sucedido e em URL/fail quando falha. Trate a URL como segredo. Vazio = desativado.
BACKUP_PING_URL=
