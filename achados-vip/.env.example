# =============================================================================
# Achados VIP — variáveis para DESENVOLVIMENTO LOCAL
# =============================================================================
# Uso (a partir da raiz do projeto):
#   cp .env.example apps/api/.env
# A API e o worker leem o ".env" do diretório onde rodam (apps/api); o Prisma CLI também.
# Para PRODUÇÃO use infra/.env.example (docker compose) — não este arquivo.
#
# Neste arquivo ficam apenas valores de DESENVOLVIMENTO. Nunca reutilize estes valores em produção
# e nunca coloque segredos reais num arquivo versionado.
# =============================================================================

# development | test | production. Em "production" a API exige TODOS os segredos abaixo e recusa defaults inseguros.
NODE_ENV=development

# --- Banco e filas -----------------------------------------------------------
# PostgreSQL 16. Exemplo com Docker:  docker run -d --name achados-pg -e POSTGRES_USER=achados \
#   -e POSTGRES_PASSWORD=achados -e POSTGRES_DB=achados -p 127.0.0.1:5432:5432 postgres:16-alpine
DATABASE_URL=postgresql://achados:achados@localhost:5432/achados

# Redis 7 (filas BullMQ). Exemplo com Docker:  docker run -d --name achados-redis -p 127.0.0.1:6379:6379 \
#   redis:7-alpine redis-server --appendonly yes --maxmemory-policy noeviction
# Com senha: redis://:SENHA@localhost:6379   (a senha precisa ser URL-safe: letras e números)
REDIS_URL=redis://localhost:6379

# --- Segredos ----------------------------------------------------------------
# Em desenvolvimento, se ficarem VAZIOS a API usa valores fixos e INSEGUROS (e avisa no log).
# Para usar valores próprios:
#   APP_ENCRYPTION_KEY:  openssl rand -base64 32      (base64 de exatamente 32 bytes)
#   SESSION_SECRET:      openssl rand -base64 48      (mínimo 32 caracteres)
# Atenção: trocar APP_ENCRYPTION_KEY torna ilegíveis as credenciais já salvas no banco local.
APP_ENCRYPTION_KEY=
SESSION_SECRET=

# --- Servidor HTTP da API ----------------------------------------------------
PORT=3001
HOST=127.0.0.1
# Cookie "Secure" exige HTTPS: em http://localhost deixe false. Em produção o compose define true.
COOKIE_SECURE=false
# true somente atrás de proxy reverso confiável (em produção, o Caddy). Em desenvolvimento: false.
TRUST_PROXY=false
# Origem do painel. Mutações com o cabeçalho Origin diferente são recusadas (proteção CSRF).
# Acesse o painel SEMPRE por este endereço (http://localhost:3000, não 127.0.0.1).
WEB_ORIGIN=http://localhost:3000

# fatal | error | warn | info | debug | trace | silent  (padrão: info; em testes: silent)
LOG_LEVEL=debug

# --- Mercado Livre (opcional; ver docs/INTEGRACOES.md) ------------------------
# Sem estas variáveis (nem credencial no painel) a fonte "mercadolivre_api" mostra "Autenticação necessária".
# Para testar o fluxo sem o ML, use a fonte "fixture" (dados de TESTE, marcados como tal) em Automação.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=

# --- Criação do administrador (npm -w apps/api run admin:create) -------------
# Prefira passar na linha de comando, só para aquele comando, em vez de gravar a senha aqui:
#   ADMIN_EMAIL=voce@exemplo.com ADMIN_PASSWORD='uma-senha-longa-12+' npm -w apps/api run admin:create
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- Testes automatizados (vitest) -------------------------------------------
# Banco e Redis DEDICADOS a testes: os testes de integração APAGAM dados deles. Nunca aponte para o banco de desenvolvimento.
# O vitest.config.ts já tem estes valores como padrão; defina só se os seus forem diferentes.
# TEST_DATABASE_URL=postgresql://achados:achados@localhost:5432/achados_test
# TEST_REDIS_URL=redis://localhost:6379/15

# --- Painel (Next.js) --------------------------------------------------------
# NÃO é lido daqui: o Next só lê .env do próprio diretório. Crie apps/web/.env.local com:
#   API_INTERNAL_URL=http://localhost:3001
# (destino do proxy same-origin /api/* -> API; o padrão embutido no Next aponta para a porta 4000)
