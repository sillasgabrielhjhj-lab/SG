DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/mercatto?schema=public"
REDIS_URL="redis://localhost:6379"

# Auth — gere segredos fortes (ex: openssl rand -hex 32)
JWT_SECRET=""
JWT_REFRESH_SECRET=""
SESSION_COOKIE_NAME="mercatto_session"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# E-mail (SMTP) — usado para verificação de e-mail e recuperação de senha
EMAIL_FROM="Mercatto <no-reply@seudominio.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Pagamentos — em desenvolvimento use "mock" (não processa cartão real).
# Troque para "mercadopago" em produção, com credenciais próprias abaixo.
PAYMENT_PROVIDER="mock"
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
