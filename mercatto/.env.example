# =============================================================================
# MERCATTO — variáveis de ambiente
# Copie para .env (desenvolvimento) e configure na Vercel (Settings > Environment
# Variables) para produção. NUNCA versione valores reais.
# =============================================================================

# --- Banco de dados (PostgreSQL 14+) -----------------------------------------
# Desenvolvimento local:
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/mercatto?schema=public"
# Produção (Vercel + Neon/Supabase/Prisma Postgres): use a URL com POOLING
# (ex.: Neon "-pooler" com ?sslmode=require). Migrations usam a mesma URL.
# Banco exclusivo para testes de integração (o nome DEVE conter "test"):
TEST_DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/mercatto_test?schema=public"

# --- Aplicação ----------------------------------------------------------------
# URL pública (sem barra final). Usada em links de e-mail, SEO, webhooks e CSRF.
APP_URL="http://localhost:3000"
# Segredo da aplicação (mín. 32 caracteres). Gere com: openssl rand -base64 48
AUTH_SECRET="troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres"
# Nível de log: debug | info | warn | error
LOG_LEVEL="info"

# --- Pagamentos -----------------------------------------------------------------
# "dev"         => gateway de DESENVOLVIMENTO (nenhuma cobrança real; PIX não pagável;
#                  aprovação/recusa simuladas pelo mesmo fluxo de webhook assinado)
# "mercadopago" => Mercado Pago (requer credenciais e validação em sandbox)
PAYMENT_PROVIDER="dev"
# Segredo HMAC dos webhooks do gateway "dev" (mín. 16 caracteres)
PAYMENT_WEBHOOK_SECRET="troque-este-segredo-de-webhook"
# Mercado Pago (Painel do desenvolvedor > Suas integrações > Credenciais)
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
# Webhooks > Assinatura secreta (validação do header x-signature)
MERCADOPAGO_WEBHOOK_SECRET=""

# --- Frete ----------------------------------------------------------------------
# "table"       => tabela própria configurável (ShippingRule) — funciona sem terceiros
# "melhorenvio" => cotação via Melhor Envio (requer token)
SHIPPING_PROVIDER="table"
MELHORENVIO_TOKEN=""

# --- E-mail ---------------------------------------------------------------------
# "console" => apenas registra (desenvolvimento) | "resend" => envio real
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="Mercatto <nao-responda@seudominio.com.br>"

# --- Armazenamento de imagens ---------------------------------------------------
# "local"       => public/uploads (SOMENTE desenvolvimento; a Vercel é somente leitura)
# "vercel-blob" => Vercel Blob (Storage > Blob > conectar ao projeto cria o token)
STORAGE_PROVIDER="local"
BLOB_READ_WRITE_TOKEN=""

# --- CEP ------------------------------------------------------------------------
# "viacep" => consulta pública ViaCEP (com preenchimento manual como fallback)
CEP_PROVIDER="viacep"

# --- Cron (Vercel Cron envia Authorization: Bearer <CRON_SECRET>) --------------
CRON_SECRET="troque-este-segredo-do-cron"

# --- Seed -----------------------------------------------------------------------
# demo    => dados fictícios marcados como DEMO (padrão fora de produção)
# minimal => somente configurações, categorias, regras de frete, admin e loja oficial
SEED_MODE="demo"
# Obrigatórios no modo minimal (primeiro administrador):
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador Mercatto"
